# Petir 2 Nelayan Sungailiat — deployment template only.
# Copy to .env on the deployment host. Never commit the real .env.

# Immutable release identity. Use the exact verified Git SHA for both values.
PETIR2_GIT_SHA=REPLACE_WITH_FULL_40_CHAR_VERIFIED_SHA
PETIR2_IMAGE_TAG=sha-REPLACE_WITH_12_CHAR_SHA

# Generate URL-safe values, for example: openssl rand -hex 32
PETIR2_DB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_HEX
PETIR2_MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_HEX
PETIR2_APP_DB_PASSWORD=CHANGE_ME_APP_HEX

# Dedicated durable paths; create them only during the approved deployment phase.
PETIR2_POSTGRES_DATA_DIR=/mnt/data/apps/petir2-nelayan/postgres
PETIR2_SNAPSHOT_DIR=/mnt/data/apps/petir2-nelayan/snapshots

# Authentication decision:
# - false: require Cloudflare Access on dashboard/admin routes before publication;
#          keep /api/ingest/sync-batch reachable for registered node bearer tokens.
# - true: callers must send X-API-Key; current browser UI does not store this secret.
PETIR2_DASHBOARD_AUTH_ENABLED=false
PETIR2_DASHBOARD_API_KEY=

# Privileged API authentication is independent from public monitoring.
# Keep disabled until Phase 3 explicitly configures either API-key or verified
# Cloudflare Access JWT authentication. Never put these values in frontend env.
PETIR2_ADMIN_AUTH_MODE=disabled
PETIR2_ADMIN_API_KEY=
PETIR2_OPERATOR_API_KEY=
PETIR2_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
PETIR2_CLOUDFLARE_ACCESS_AUDIENCE=
PETIR2_CLOUDFLARE_ACCESS_ADMIN_EMAILS=
PETIR2_CLOUDFLARE_ACCESS_OPERATOR_EMAILS=

PETIR2_RATE_LIMIT_PER_NODE=120
PETIR2_RATE_LIMIT_WINDOW_SECONDS=60
PETIR2_CORS_ALLOW_ORIGINS=
PETIR2_SIREN_AUDIT_OPERATORS_JSON=[]

# Public, non-secret site identity. Read by Next.js at container request time.
PETIR_SITE_NAME=Nelayan Sungailiat
PETIR_STATION_VERSION=2.0
PETIR_SITE_ID=nelayan-sungailiat
PETIR_PUBLIC_DOMAIN=nelayan-sungailiat.petirlabs.com
PETIR_RAIN_SEMANTICS=rolling_1m_max
