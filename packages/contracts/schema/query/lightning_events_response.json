{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petirlabs.com/contracts/query/lightning-events-response.json",
  "title": "LightningEventsResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "items", "meta"],
  "properties": {
    "node_id": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "ts_pi_utc", "event_type", "distance_km", "energy_raw", "noise_level", "source", "device"],
        "properties": {
          "edge_id": {"type": "integer"},
          "ts_pi_utc": {"type": "string", "format": "date-time"},
          "event_type": {"enum": ["lightning", "disturber", "noise", null]},
          "distance_km": {"type": ["number", "null"]},
          "energy_raw": {"type": ["integer", "null"]},
          "noise_level": {"type": ["integer", "null"]},
          "source": {"type": ["string", "null"]},
          "device": {"type": ["string", "null"]}
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "page", "page_size", "total_items", "total_pages", "has_prev", "has_next"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "page": {"type": "integer", "minimum": 1},
        "page_size": {"type": "integer", "minimum": 1},
        "total_items": {"type": "integer", "minimum": 0},
        "total_pages": {"type": "integer", "minimum": 1},
        "has_prev": {"type": "boolean"},
        "has_next": {"type": "boolean"},
        "requested_limit": {"type": "integer", "minimum": 1},
        "scope": {"type": "string"}
      }
    }
  }
}
